+import { z } from 'zod';
+import type { FastifyReply } from 'fastify';
+
+export const CheckoutOrder = z.object({
+  id: z.string(),
+  total: z.number(),
+});
+export type CheckoutOrder = z.infer<typeof CheckoutOrder>;
+
+export function priceOrder(order: CheckoutOrder, reply?: FastifyReply): number {
+  return order.total;
+}
