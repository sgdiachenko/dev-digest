+export function FindingList({ items, count }: { items: { title: string; hidden: boolean }[]; count: number }) {
+  return (
+    <div>
+      {count && <span>{count} findings</span>}
+      <ul>
+        {items
+          .filter((item) => !item.hidden)
+          .map((item, index) => (
+            <li key={index}>{item.title}</li>
+          ))}
+      </ul>
+    </div>
+  );
+}
